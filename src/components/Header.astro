---
import LangToggle from './LangToggle.astro';
import { useTranslations, homePath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  translationPath: string;
}

const { lang, translationPath } = Astro.props;
const t = useTranslations(lang);
const home = homePath(lang);

const navItems = [
  { href: `${home}#sobre`, label: t('nav.sobre') },
  { href: `${home}#skills`, label: t('nav.habilidades') },
  { href: `${home}#projetos`, label: t('nav.projetos') },
  { href: `${home}#contato`, label: t('nav.contato') },
];
---

<header
  class="sticky top-0 z-50"
  style="backdrop-filter: blur(10px); background: color-mix(in srgb, #161826 78%, transparent);"
>
  <div class="mx-auto flex max-w-[1180px] items-center gap-7 px-8 py-4">
    <a href={home} class="mr-auto flex items-center gap-2.5 no-underline" style="color: var(--color-text);">
      <span
        class="grid h-[30px] w-[30px] place-items-center rounded-lg border text-[13px]"
        style="border-color: var(--color-accent); color: var(--color-accent); font-family: var(--font-heading); letter-spacing: -0.02em;"
      >
        PJ
      </span>
      <span style="font-family: var(--font-heading); font-size: 15px;">
        paulodjunior<span style="color: var(--color-accent);">.dev</span>
      </span>
    </a>

    <nav class="hidden gap-[22px] md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-[13.5px] no-underline transition-colors hover:text-[var(--color-accent)]"
            style="color: color-mix(in srgb, var(--color-text) 68%, transparent);"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3.5">
      <LangToggle lang={lang} translationPath={translationPath} />
      <a class="btn btn-primary hidden text-[13px] md:inline-flex" href={`${home}#contato`}>
        {t('nav.contratar')}
      </a>
      <button
        id="menu-toggle"
        aria-label="Abrir menu"
        class="flex h-9 w-9 items-center justify-center md:hidden"
        style="color: var(--color-text);"
      >
        <svg id="menu-icon-open" width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M2.5 5h15M2.5 10h15M2.5 15h15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <svg id="menu-icon-close" width="20" height="20" viewBox="0 0 20 20" fill="none" class="hidden">
          <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div style="height:1px;background:linear-gradient(to right,transparent,var(--color-divider) 48px,var(--color-divider) calc(100% - 48px),transparent);"></div>

  <nav id="mobile-navbar" class="hidden flex-col px-8 py-4 md:hidden" style="background: var(--color-surface);">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="border-b py-3 text-[14px] no-underline"
          style="border-color: var(--color-divider); color: color-mix(in srgb, var(--color-text) 68%, transparent);"
        >
          {item.label}
        </a>
      ))
    }
    <a class="btn btn-primary btn-block text-[13px]" href={`${home}#contato`}>
      {t('nav.contratar')}
    </a>
  </nav>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileNavbar = document.getElementById('mobile-navbar');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  menuToggle?.addEventListener('click', () => {
    mobileNavbar?.classList.toggle('hidden');
    mobileNavbar?.classList.toggle('flex');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
