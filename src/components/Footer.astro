---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer
  style="max-width:1180px;margin:0 auto;padding:28px 32px 56px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:20px;font-size:12px;color:color-mix(in srgb, var(--color-text) 45%, transparent);"
>
  <span>{t('footer.location')}</span>
  <span>{t('footer.made')}</span>
</footer>
