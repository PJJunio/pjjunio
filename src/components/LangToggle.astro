---
import { languages } from '../i18n/ui';
import { getAlternateLang, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  translationPath: string;
}

const { lang, translationPath } = Astro.props;
const alternate = getAlternateLang(lang);
---

<div
  class="inline-flex overflow-hidden rounded-full border"
  style="border-color: var(--color-divider);"
>
  <span
    class="px-[11px] py-[5px] text-[12px]"
    style={`color: var(--color-accent); box-shadow: inset 0 0 0 1px var(--color-accent);`}
  >
    {languages[lang]}
  </span>
  <a
    href={translationPath}
    class="border-l px-[11px] py-[5px] text-[12px] transition-colors hover:text-[var(--color-accent)]"
    style="border-color: var(--color-divider); color: color-mix(in srgb, var(--color-text) 60%, transparent);"
    aria-label={`Switch to ${languages[alternate]}`}
  >
    {languages[alternate]}
  </a>
</div>
