---
import { useTranslations, projectPath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  badge: string;
  description: string;
  stack: string[];
  status: 'private' | 'public';
  image: string;
  variant: 'large' | 'small';
}

const { lang, slug, title, badge, description, stack, status, image, variant } = Astro.props;
const t = useTranslations(lang);
const href = projectPath(lang, slug);
const statusLabel = status === 'private' ? t('projeto.status.private') : t('projeto.status.public');
const muted = 'color-mix(in srgb, var(--color-text) 45%, transparent)';
---

{
  variant === 'large' ? (
    <a
      href={href}
      style="grid-column:span 3;border-radius:var(--radius-lg);overflow:hidden;background:#1c1e2c;box-shadow:var(--shadow-sm);display:flex;flex-direction:column;text-decoration:none;color:inherit;"
      class="project-card-large"
    >
      <div style={`position:relative;height:236px;background:#12141f;background-image:url(${image});background-size:cover;background-position:center;`} />
      <div style="padding:22px 24px 24px;display:flex;flex-direction:column;gap:12px;flex:1;">
        <div style="display:flex;align-items:center;gap:10px;">
          <span class="tag tag-accent">{badge}</span>
          <span style={`font-size:11px;color:${muted};`}>{statusLabel}</span>
        </div>
        <h3 style="font-size:25px;letter-spacing:-.02em;margin:0;">{title}</h3>
        <p style="font-size:13.5px;line-height:1.6;margin:0;color:color-mix(in srgb, var(--color-text) 68%, transparent);">
          {description}
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;">
          {stack.map((s) => (
            <span class="tag tag-outline">{s}</span>
          ))}
        </div>
      </div>
    </a>
  ) : (
    <a
      href={href}
      style="grid-column:span 2;border-radius:var(--radius-lg);padding:22px;background:#1a1c29;box-shadow:var(--shadow-sm);display:flex;flex-direction:column;gap:12px;min-height:210px;text-decoration:none;color:inherit;"
    >
      <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;">
        <span class="tag tag-neutral" style="background:#282b3b;">
          {badge}
        </span>
        <span style={`font-size:11px;color:${muted};`}>{statusLabel}</span>
      </div>
      <h4 style="font-size:19px;letter-spacing:-.02em;margin:0;">{title}</h4>
      <p style="font-size:13px;line-height:1.55;margin:0;flex:1;color:color-mix(in srgb, var(--color-text) 64%, transparent);">
        {description}
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:6px;">
        {stack.map((s) => (
          <span style="font-size:11px;color:var(--color-accent-400);">{s}</span>
        ))}
      </div>
    </a>
  )
}
