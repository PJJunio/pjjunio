---
import ProjectCard from './ProjectCard.astro';
import type { Lang } from '../i18n/utils';

interface ProjectEntry {
  id: string;
  data: {
    title: string;
    badge: string;
    description: string;
    stack: string[];
    status: 'private' | 'public';
    image: string;
    order: number;
  };
}

interface Props {
  lang: Lang;
  projects: ProjectEntry[];
}

const { lang, projects } = Astro.props;
const sorted = [...projects].sort((a, b) => a.data.order - b.data.order);
---

<div style="display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px;" class="bento-grid">
  {
    sorted.map((project, i) => (
      <ProjectCard
        lang={lang}
        slug={project.id}
        title={project.data.title}
        badge={project.data.badge}
        description={project.data.description}
        stack={project.data.stack}
        status={project.data.status}
        image={project.data.image}
        variant={i < 2 ? 'large' : 'small'}
      />
    ))
  }
</div>

<style>
  @media (max-width: 700px) {
    .bento-grid {
      grid-template-columns: 1fr !important;
    }
    .bento-grid > :global(a) {
      grid-column: span 1 !important;
    }
  }
</style>
