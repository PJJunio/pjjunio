---
import { useTranslations, homePath, projectPath, type Lang } from '../i18n/utils';

interface ProjectData {
  title: string;
  badge: string;
  description: string;
  stack: string[];
  status: 'private' | 'public';
  repoUrl?: string;
  image: string;
}

interface OtherProject {
  slug: string;
  title: string;
  badge: string;
}

interface Props {
  lang: Lang;
  project: ProjectData;
  otherProjects: OtherProject[];
}

const { lang, project, otherProjects } = Astro.props;
const t = useTranslations(lang);

const statusLabel = project.status === 'private' ? t('projeto.status.private') : t('projeto.status.public');
const repoNote = project.status === 'private' ? t('projeto.note.private') : t('projeto.note.public');
const muted = (pct: number) => `color-mix(in srgb, var(--color-text) ${pct}%, transparent)`;
---

<div style="max-width:980px;margin:0 auto;padding:56px 32px 80px;">
  <a
    href={`${homePath(lang)}#projetos`}
    class="btn btn-ghost"
    style="padding-left:0;margin-bottom:40px;background:transparent;font-family:inherit;text-decoration:none;"
  >
    ← {t('projeto.back')}
  </a>

  <div style="display:flex;align-items:center;gap:10px;margin-bottom:18px;">
    <span class="tag tag-accent">{project.badge}</span>
    <span style={`font-size:11.5px;color:${muted(48)};`}>{statusLabel}</span>
  </div>

  <h1 style="font-size:clamp(34px,6vw,56px);letter-spacing:-.035em;margin:0 0 22px;">{project.title}</h1>
  <p style={`font-size:17px;line-height:1.65;max-width:62ch;margin:0 0 34px;color:${muted(76)};`}>
    {project.description}
  </p>

  <div
    style={`position:relative;height:400px;border-radius:var(--radius-lg);overflow:hidden;background:#12141f;box-shadow:var(--shadow-sm);margin-bottom:40px;background-image:url(${project.image});background-size:cover;background-position:center;`}
  />

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;" class="detail-grid">
    <div>
      <h6 style={`color:${muted(55)};margin-bottom:14px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;`}>
        {t('projeto.stack')}
      </h6>
      <div style="display:flex;flex-wrap:wrap;gap:6px;">
        {project.stack.map((s) => (
          <span class="tag tag-outline">{s}</span>
        ))}
      </div>
    </div>
    <div>
      <h6 style={`color:${muted(55)};margin-bottom:14px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;`}>
        {t('projeto.repoEyebrow')}
      </h6>
      <p style={`font-size:13.5px;line-height:1.6;color:${muted(62)};margin:0 0 14px;`}>{repoNote}</p>
      {project.status === 'public' && project.repoUrl && (
        <a class="btn btn-primary" href={project.repoUrl} target="_blank" rel="noopener noreferrer">
          {t('projeto.repo')}
        </a>
      )}
    </div>
  </div>

  {otherProjects.length > 0 && (
    <>
      <div class="hr" />
      <h6 style={`color:${muted(55)};margin-bottom:18px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;`}>
        {t('projeto.others')}
      </h6>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;">
        {otherProjects.map((p) => (
          <a
            href={projectPath(lang, p.slug)}
            style="border-radius:var(--radius-md);padding:16px;background:#1a1c29;box-shadow:var(--shadow-sm);text-decoration:none;color:inherit;display:block;"
          >
            <div style="font-size:14px;margin-bottom:6px;">{p.title}</div>
            <div style={`font-size:11.5px;color:${muted(48)};`}>{p.badge}</div>
          </a>
        ))}
      </div>
    </>
  )}
</div>

<style>
  @media (max-width: 640px) {
    .detail-grid {
      grid-template-columns: 1fr !important;
      gap: 28px !important;
    }
  }
</style>
