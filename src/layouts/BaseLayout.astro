---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  translationPath: string;
  title?: string;
  description?: string;
}

const { lang, translationPath, title, description } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="m-0 min-h-screen text-[15px] leading-[1.55]"
    style="background: radial-gradient(1200px 600px at 12% -10%, #1e2138 0%, #161826 60%);"
  >
    <Header lang={lang} translationPath={translationPath} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
